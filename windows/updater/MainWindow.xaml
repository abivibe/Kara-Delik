<Window x:Class="KaraDelik.Updater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kara Delik Updater"
        Width="372"
        Height="179"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Topmost="True"
        Icon="pack://application:,,,/app_icon.ico">
    <Border x:Name="RootBorder"
            CornerRadius="14"
            BorderThickness="1.2"
            Background="{DynamicResource WindowBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            Padding="22,18,22,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Sequential Fading Status Text -->
                <RowDefinition Height="36" />
                <!-- Row 1: Centered Animated Loading Spinner -->
                <RowDefinition Height="*" />
                <!-- Row 2: Bottom Progress Bar and Percentage -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Text: Fade-in / Fade-out sequential text -->
            <TextBlock x:Name="StatusTextBlock"
                       Grid.Row="0"
                       Text="Güncellemeler yapılıyor..."
                       FontSize="13.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />

            <!-- Centered Rotating Loading Circle (Spinner) -->
            <Viewbox Grid.Row="1" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="40" Height="40">
                    <!-- Static track ring -->
                    <Ellipse Width="40" Height="40"
                             Stroke="{DynamicResource TrackBrush}"
                             StrokeThickness="3.5" />
                    <!-- Rotating spinner arc -->
                    <Path Stroke="{DynamicResource AccentBrush}"
                          StrokeThickness="3.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeDashArray="3 2.2"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.Data>
                            <EllipseGeometry RadiusX="18.25" RadiusY="18.25" Center="20,20" />
                        </Path.Data>
                        <Path.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" Angle="0" />
                        </Path.RenderTransform>
                    </Path>
                </Canvas>
            </Viewbox>

            <!-- Bottom: Detail text & Thin Progress Bar -->
            <Grid Grid.Row="2" Margin="0,4,0,2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,4">
                    <TextBlock x:Name="StepDetailTextBlock"
                               Text="İndiriliyor..."
                               FontSize="11"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Left" />
                    <TextBlock x:Name="PercentTextBlock"
                               Text="%0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Right" />
                </Grid>

                <!-- Thin modern progress bar -->
                <ProgressBar x:Name="DownloadProgressBar"
                             Grid.Row="1"
                             Height="4"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             BorderThickness="0"
                             Background="{DynamicResource TrackBrush}"
                             Foreground="#3B82F6">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid x:Name="PART_Track" ClipToBounds="True">
                                <Border CornerRadius="2" Background="{TemplateBinding Background}" />
                                <Border x:Name="PART_Indicator"
                                        CornerRadius="2"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsIndeterminate" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="PulseProgress">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PART_Indicator"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="0.35" To="1" Duration="0:0:0.7"
                                                                 AutoReverse="True" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <RemoveStoryboard BeginStoryboardName="PulseProgress" />
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
            </Grid>
        </Grid>
    </Border>
</Window>
